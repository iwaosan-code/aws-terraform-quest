# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# 実際の変数値はGitに含めない
*.tfvars
*.tfvars.json

# ただしサンプルはGitに含める
!*.tfvars.example
!*.tfvars.json.example

# Terraform plan files
*.tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json